import os
import shutil
import subprocess
import sys

# 1. Definir caminhos exatos para a pasta app_android
TARGET_DIR = r"C:\Users\t.ventura\Desktop\app_android"
APP_NAME = "data_analyzer"
PACKAGE_DIR = os.path.join(TARGET_DIR, "src", APP_NAME)

PYPROJECT_CONTENT = f"""[tool.briefcase]
project_name = "Data Analyzer Pro"
bundle = "com.example"
version = "0.1.0"
url = "https://example.com/dataanalyzer"
license = "MIT"
author = "Developer"
author_email = "developer@example.com"

[tool.briefcase.app.{APP_NAME}]
formal_name = "Data Analyzer Pro"
description = "App para cruzamento e analise de bases CSV/XLS"
icon = "src/{APP_NAME}/resources/{APP_NAME}"
sources = [
    "src/{APP_NAME}",
]
test_sources = [
    "tests",
]

requires = [
    "toga>=0.4.0",
    "pandas>=2.0.0",
    "openpyxl>=3.1.0",
]

[tool.briefcase.app.{APP_NAME}.android]
build_style = "aab"
"""

def run_command(command, cwd_dir):
    print(f"\n[EXEC] > {command}")
    result = subprocess.run(command, shell=True, cwd=cwd_dir)
    if result.returncode != 0:
        print(f"[ERRO] Falha ao executar: {command}")
        sys.exit(1)

def main():
    print(f"=== INICIANDO BUILD NO DIRETÓRIO: {TARGET_DIR} ===")

    # Garantir que o script está executando dentro da pasta app_android
    os.chdir(TARGET_DIR)

    # 2. Criar estrutura de pacotes exigida pelo BeeWare
    print("\n1. Criando estrutura de pastas internas...")
    os.makedirs(PACKAGE_DIR, exist_ok=True)
    os.makedirs(os.path.join(PACKAGE_DIR, "resources"), exist_ok=True)

    # 3. Criar __init__.py e mover os scripts mainpy.py e analyzerpy.py
    print("2. Mapeando arquivos mainpy.py e analyzerpy.py...")
    
    with open(os.path.join(PACKAGE_DIR, "__init__.py"), "w", encoding="utf-8") as f:
        f.write("# Package initialization\n")

    main_src = os.path.join(TARGET_DIR, "mainpy.py")
    if os.path.exists(main_src):
        shutil.copy(main_src, os.path.join(PACKAGE_DIR, "app.py"))
    else:
        print(f"[ERRO] {main_src} não encontrado!")
        sys.exit(1)

    analyzer_src = os.path.join(TARGET_DIR, "analyzerpy.py")
    if os.path.exists(analyzer_src):
        shutil.copy(analyzer_src, os.path.join(PACKAGE_DIR, "analyzerpy.py"))
    else:
        print(f"[ERRO] {analyzer_src} não encontrado!")
        sys.exit(1)

    # 4. Gerar o pyproject.toml na raiz de app_android
    print("3. Criando pyproject.toml...")
    with open(os.path.join(TARGET_DIR, "pyproject.toml"), "w", encoding="utf-8") as f:
        f.write(PYPROJECT_CONTENT)

    # 5. Instalar Briefcase e executar o Build Android via módulo Python (evita erro de PATH)
    print("4. Instalando dependências de build...")
    run_command(f"{sys.executable} -m pip install briefcase", TARGET_DIR)

    print("5. Criando projeto Android...")
    run_command(f"{sys.executable} -m briefcase create android", TARGET_DIR)

    print("6. Compilando o aplicativo Android...")
    run_command(f"{sys.executable} -m briefcase build android", TARGET_DIR)

    print("7. Empacotando o APK/AAB final...")
    run_command(f"{sys.executable} -m briefcase package android", TARGET_DIR)

    print("\n==================================================")
    print("✅ PROCESSO CONCLUÍDO COM SUCESSO!")
    print(f"O projeto Android foi gerado em: {os.path.join(TARGET_DIR, 'build')}")
    print("==================================================")

if __name__ == "__main__":
    main()
